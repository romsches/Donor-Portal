<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"> <!-- Character encoding -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!-- Ensure proper rendering on all devices -->
    <meta name="description" content="Login error page for donor portal"> <!-- SEO and accessibility description -->
    <title>Login Error</title> <!-- Page title -->
    <link rel="stylesheet" href="/css/main.css"> <!-- Link to main CSS file -->
</head>
<body>
    <!-- Custom header and logo components -->
    <special-header></special-header>
    <special-logo></special-logo>

    <main>
        <!-- Error message section -->
        <section class="error-section" role="alert" aria-live="assertive">
            <h1>Login Error</h1>
            <p class="login_fehler"><%= error %></p>
            <a href="/" class="back-link">Back to Login</a>
        </section>

        <!-- Help and support section -->
        <div class="hilfe">
            <h2>Need Help?</h2>
            <p>Having trouble logging in?</p>
            <p>Visit our <a href="#">Help Center</a> to find answers about the login process.</p>
            <p>Or open the <strong style="color: rgb(27, 29, 117);">Chatbot</strong> in the bottom-right corner to get instant assistance.</p>
            <p>You can also contact us via email at 
                <a href="mailto:spender-portal@blutspende.de" class="email">spender-portal@blutspende.de</a>
                or call us at 
                <a href="tel:+49123456789" class="telefon">+49 123 456789</a>.
            </p>
        </div>

        <!-- Chat widget -->
        <div id="chat-container" aria-live="polite" hidden>
            <div id="chat-header">
                <h2>Chat</h2>
                <button id="chat-close" aria-label="Close chat">&times;</button>
            </div>
            <div id="chat-messages"></div>
            <div id="chat-footer">
                <input type="text" id="chat-input" placeholder="Your message..." aria-label="Type your message">
                <button id="chat-send-button">Send</button>
            </div>
        </div>

        <!-- Chat toggle button -->
        <button id="chat-toggle" aria-controls="chat-container" aria-expanded="false">
            Open Chatbot
        </button>
    </main>

    <!-- Custom footer -->
    <special-footer></special-footer>

    <!-- JavaScript files -->
    <script src="/js/main.js"></script>
    <script src="/js/chatbot.js"></script>
</body>
</html>
