<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/css/main.css">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
</head>
<body>
    <!-- Header and Logo -->
    <special-header></special-header>
    <special-logo></special-logo>

    <main id="admin-dashboard">
        <section class="dashboard">
            <h1>Admin Dashboard</h1>
            <p>Welcome, <%= adminName %>!</p>
            <p><a href="#" id="logout-link">Logout</a></p>

            <% if (privileges.includes('admin')) { %>
            <!-- Chatbot Management -->
            <div id="chatbot-control-toggle">
                <label for="chatbot-control-checkbox">Chatbot Control</label>
                <input type="checkbox" id="chatbot-control-checkbox">
            </div>

            <div id="chatbot-control" style="display:none;">
                <h2>Chatbot Management</h2>

                <!-- Select an action for chatbot -->
                <label for="action-select">Select an action:</label>
                <select id="action-select">
                    <option value="">Select action</option>
                    <option value="view">Edit questions and answers</option>
                </select>

                <!-- Section selection container -->
                <div id="section-container" style="display:none;">
                    <label for="chatbot-sections">Select a section:</label>
                    <select id="chatbot-sections">
                        <option value="">All sections</option>
                    </select>
                </div>

                <!-- Container for question table -->
                <div id="questions-table-container" style="display:none;">
                    <div id="button-container">
                        <button id="submit-edit">Edit</button>
                        <button id="submit-delete">Delete record</button>
                        <button id="submit-insert">Insert</button>
                        <button id="submit-delete-section">Delete section</button>
                    </div>

                    <!-- Confirmation buttons -->
                    <div id="confirm-buttons" class="dash_hidden">
                        <button id="confirm-button">Confirm</button>
                        <button id="cancel-button">Cancel</button>
                    </div>

                    <!-- Message to be deleted -->
                    <div id="delete-message" class="dash_hidden">
                        <p id="delete-instruction" style="color: red;">Select the row you want to delete:</p>
                        <p>ID: <span id="delete-id">undefined</span>, Section: <span id="delete-section">undefined</span></p>
                    </div>

                    <!-- Section removal container -->
                    <div id="delete-section-container-admin" class="dash_hidden">
                        <label for="section-select-admin">Select a section:</label>                     
                        <div id="confirm-buttons-admin" class="dash_hidden">
                            <button id="confirm-delete-button-admin">Confirm</button>
                            <button id="cancel-delete-button-admin">Cancel</button>
                        </div>
                        <div id="section-table-container"></div>
                        <div id="section-info-admin" class="dash_hidden">
                            <p>Information about the section:</p>
                            <p>ID: <span id="section-id-admin">undefined</span></p>
                            <p>Name: <span id="section-name-admin">undefined</span></p>
                            <p>Number of questions: <span id="section-count-admin">0</span></p>
                        </div>
                                    
                        <div id="warning-message-admin" class="dash_hidden">
                            <p style="color: red;">Do you really want to delete the section with ID <span id="warning-section-id-admin"></span>?</p>
                        </div>
                    </div>

                    <!-- Form to edit a question -->
                    <div id="edit-form-container" class="dash_hidden">
                        <h2>Edit Question</h2>
                        <button id="edit_confirm_button" type="submit">Confirm</button>
                        <button id="back-edit-button">Cancel</button>
                        <div id="edit-instruction" class="dash_hidden">
                            <p>Please select a row to edit:</p>
                        </div>                        
                        <form id="edit-form">
                            <label for="edit-section">Section:</label>
                            <textarea id="edit-section" required></textarea>

                            <label for="edit-question">Question:</label>
                            <textarea id="edit-question" required></textarea>

                            <label for="edit-answer">Answer:</label>
                            <textarea id="edit-answer" required></textarea>
                        </form>
                    </div>


                    <!-- Table with questions -->
                    <table id="questions-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Section</th>
                                <th>Question</th>
                                <th>Answer</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Dynamically loaded rows -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Form to add a new question -->
            <div id="insert-form-container" class="dash_hidden">
                <h2>Add New Question</h2>
                <button id="back-button">Back</button>
                <form id="insert-form">
                    <label for="insert-section">Section:</label>
                    <input type="text" id="insert-section" required>
                    <label for="insert-question">Question:</label>
                    <input type="text" id="insert-question" required>
                    <label for="insert-answer">Answer:</label>
                    <input type="text" id="insert-answer" required>
                    <button type="submit">Add</button>
                </form>
            </div>
            <% } %> <!-- End of admin privilege check -->
            <% if (privileges.includes('editor') || privileges.includes('admin')) { %>
                <h1>MANAGER CONTENT</h1>
                <br>
            <% } %> <!-- End of manager privilege check -->
        </section>
    </main>
    <p>You have privileges for: <%= JSON.stringify(privileges) %></p>


    <!-- Footer -->
    <special-footer></special-footer>
        <!-- Chat container -->
        <div id="chat-container">
            <div id="chat-header">
                <h2>Chat</h2>
                <button id="chat-close">&times;</button>
            </div>
            <div id="chat-messages"></div>
            <div id="chat-footer">
                <input type="text" id="chat-input" placeholder="Enter your message...">
                <button id="chat-send-button">Send</button>
            </div>
        </div>

        <button id="chat-toggle">Open Chatbot</button>
    <!-- scripts -->
    <script>
        let isNavigatingAway = false;

        // End session when leaving the page
        window.addEventListener('beforeunload', function (e) {
            if (isNavigatingAway) {
                fetch('/admin/logout', {
                    method: 'POST',
                    credentials: 'same-origin'
                }).then(response => {
                    if (response.ok) {
                        console.log('Session ended');
                    } else {
                        console.error('Failed to end session');
                    }
                });
            }
        });

        // Handle link clicks
        document.addEventListener('click', function (e) {
            const target = e.target;
            if (target.tagName === 'A' && target.href) {
                isNavigatingAway = true;
            }
        });

        // Handle browser back navigation
        window.addEventListener('popstate', function (e) {
            isNavigatingAway = true;
        });
    </script>
    <script>
        // Pass privileges variable to client JavaScript
        const privileges = "<%= JSON.stringify(privileges) %>";
    </script>
    
    <script src="/js/main.js"></script>
    <script src="/js/dashboard.js"></script>
    <script src="/js/chatbot.js"></script>
</body>
</html>
