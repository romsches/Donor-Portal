<!DOCTYPE html>
<html lang="de"> <!-- Sprache auf Deutsch setzen, da dein Text deutsch ist -->
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login</title>
    <meta name="description" content="Login-Seite für Administratoren des Blutspendeportals">
    <link rel="stylesheet" href="/css/main.css"> <!-- Haupt-CSS-Datei -->
</head>
<body class="admin-login-page">
    
    <!-- Custom header -->
<special-header></special-header>

<!-- Custom logo -->
<special-logo></special-logo>

<main class="admin-login-main">
    <section class="admin-login-section">
        <h1>Admin Login</h1>

        <!-- Error message for login issues -->
        <% if (typeof error !== 'undefined') { %>
            <p class="admin-login-error-message"><%= error %></p>
        <% } %>

        <!-- Admin login form -->
        <form action="/admin/login" method="post" autocomplete="off">
            <!-- Removed <fieldset> and <legend> for cleaner styling -->
            <div class="form-fields-container"> 
                <!-- Admin ID -->
                <div class="form-group">
                    <label for="adminID">Admin ID:</label>
                    <input 
                        type="text" 
                        id="adminID" 
                        name="username" 
                        required 
                        placeholder="Your Admin ID"
                        aria-label="Admin ID">
                </div>

                <!-- Password -->
                <div class="form-group admin-password-container">
                    <label for="password">Password:</label>
                    <input 
                        type="password" 
                        id="password" 
                        name="password" 
                        required 
                        minlength="6" 
                        placeholder="Your Password"
                        aria-label="Password">
                </div>

                <!-- Submit button -->
                <button type="submit" class="login-button">Login</button>
            </div>
        </form>
    </section>
</main>

<!-- Custom footer -->
<special-footer></special-footer>

<!-- Chat container -->
<div id="chat-container" aria-live="polite">
    <div id="chat-header">
        <h2>Chat</h2>
        <button id="chat-close" aria-label="Close chat">&times;</button>
    </div>
    <div id="chat-messages"></div>
    <div id="chat-footer">
        <input 
            type="text" 
            id="chat-input" 
            placeholder="Type your message..." 
            aria-label="Type your chat message">
        <button id="chat-send-button">Send</button>
    </div>
</div>

<button id="chat-toggle" aria-label="Open chatbot">Open Chatbot</button>

<!-- Scripts -->
<script src="/js/main.js"></script>
<script src="/js/chatbot.js"></script> 
<script src="/js/admin-login.js"></script> <!-- Link to admin login script -->

</body>
</html>
