<% var alreadyRendered = false; %> <!-- Variable zur Vermeidung doppelter Renderings -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Table</title>
    <link rel="stylesheet" href="/css/main.css"> <!-- Verlinkung des CSS-Stylesheets für das Design der Seite -->
</head>
<body>
    <special-header></special-header> <!-- Benutzerdefinierter Header, der das Design der Seite festlegt -->
    <special-logo></special-logo> <!-- Benutzerdefiniertes Logo, das in der Kopfzeile angezeigt wird -->
    <main>
        <section class="section_container">
            <div>
                <div class="filter">
                    <div>
                        <% if (canDonate) { %>
                            <!-- Wenn der Benutzer spenden darf, wird dieser Abschnitt angezeigt -->
                            <h1>You may donate</h1>
                        <% } else { %>
                            <!-- Wenn der Benutzer nicht spenden darf, wird dieser Abschnitt angezeigt -->
                            <h1>You are currently unable to donate.</h1>
                            <div id="donation-info">
                                <!-- Information für Benutzer -->
                                <p>The table is currently unavailable.</p>
                            </div>
                        <% } %>
                    </div>
                    <span>Next Blood Donation Appointments</span>
                    <h2>Filter by Location</h2>
                    <select id="location-filter" name="location" onchange="refreshTable()">
                        <option value="All Locations">All Locations</option> <!-- Default option for all locations -->
                        <!-- You should populate this with dynamic locations -->
                    </select>
                    <div class="filter_btn">
                        <h2>Select Date</h2>
                        <input type="date" name="date" id="dtm" maxlength="4" pattern="\d{4}" title="Enter four digits for the year" required>
                        <button id="updateButton" onclick="refreshTable()">Update</button>
                    </div>
                </div>
            </div>
            <div class="standorte">
                <% if (canDonate) { %>
                    <table id="meeting-table" border="1">
                        <thead>
                            <tr>
                                <th class="one">Date</th>
                                <% if (selectedLocation === 'All Locations') { %>
                                    <th class="two">Street (City)</th>
                                <% } else { %>
                                    <th class="two">Street</th>
                                <% } %>
                                <th class="three">Time (from - to)</th>
                                <th class="four">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (let i = 0; i < meetings.length; i++) { %>
                                <tr>
                                    <td><%= new Date(meetings[i].Datum).toLocaleDateString('en-GB') %></td>
                                    <% if (selectedLocation === 'All Locations') { %>
                                        <td><%= meetings[i].Strasse %> (<%= meetings[i].Stadt %>)</td>
                                    <% } else { %>
                                        <td><%= meetings[i].Strasse %></td>
                                    <% } %>
                                    <td><%= meetings[i].Uhrzeit %></td>
                                    <td><%= meetings[i].Status %></td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                <% } else { %>
                    <div id="donation-info">
                        <p>You are currently unable to donate.</p>
                    </div>
                    <div id="no-donation-info">
                        <p>The table is currently unavailable.</p>
                    </div>
                <% } %>
            </div>
            <div class="kontakt">
                <p>Do you have any questions?</p>
                <p>Contact our hotline.</p>
                <a href="#">Contact us</a>
            </div>
        
            <!-- HTML für den Chat -->
            <div id="chat-container">
                <div id="chat-header">
                    <h2>Chat</h2>
                    <button id="chat-close">&times;</button>
                </div>
                <div id="chat-messages"></div>
                <div id="chat-footer">
                    <input type="text" id="chat-input" placeholder="Your message...">
                    <button id="chat-send-button">Send</button>
                </div>
            </div>
            <button id="chat-toggle">Open Chatbot</button>
            
        </section>        
    </main>
    <special-footer></special-footer> <!-- Benutzerdefinierter Footer -->
    <script>
        document.addEventListener('DOMContentLoaded', function() { // Warten auf DOMContentLoaded 
            initializeLogoutTimer(); // Initialisierung des Logout-Timers 
            setMinDate(); // Setzen des minimalen Datums 
            setInitialDate(); // Setzen des Initialdatums 
            refreshTable(); // Initiales Laden der Tabelle 
            loadCities(); // Laden der Städte in den Filter 
        });
    </script>
    <script src="/js/table.js"></script> <!-- Verlinkung des JavaScript-Files für die Tabelle Seite -->
    <script src="/js/chatbot.js"></script>
</body>
</html>
